{
  "name": "Transfer",
  "type": "object",
  "properties": {
    "amount_usd": {
      "type": "number"
    },
    "amount_php": {
      "type": "number"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_bank": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "reversed"
      ],
      "default": "completed"
    },
    "rate": {
      "type": "number"
    },
    "fee": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "remittance",
        "bills",
        "subscriptions",
        "savings",
        "deposit",
        "yield",
        "other"
      ],
      "default": "remittance"
    },
    "merchant_name": {
      "type": "string"
    },
    "merchant_emoji": {
      "type": "string"
    },
    "merchant_color": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    }
  },
  "required": [
    "amount_usd",
    "recipient_name"
  ]
}