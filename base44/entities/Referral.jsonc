{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string"
    },
    "referred_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "joined",
        "rewarded"
      ],
      "default": "pending"
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "referrer_email",
    "referred_email"
  ]
}