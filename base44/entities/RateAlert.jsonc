{
  "name": "RateAlert",
  "type": "object",
  "properties": {
    "currency_pair": {
      "type": "string",
      "default": "USD/PHP"
    },
    "target_rate": {
      "type": "number"
    },
    "direction": {
      "type": "string",
      "enum": [
        "above",
        "below"
      ],
      "default": "above"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "triggered": {
      "type": "boolean",
      "default": false
    },
    "triggered_at": {
      "type": "string"
    }
  },
  "required": [
    "target_rate",
    "direction"
  ]
}